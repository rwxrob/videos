#!/usr/bin/env bash
# yt-update: push title and description from data/<UID>.md to YouTube, or the
# channel description from channel.md.
#
# Usage: yt-update [-n] [-y] <UID>
#        yt-update channel
#        yt-update privacy <idfile> [public|unlisted|private]
#        yt-update auth
#   -n  dry run: only parse the markdown and print the title/description
#   -y  skip the confirmation prompt
#   channel  update the channel description from channel.md
#   privacy  set the privacy of every video ID in <idfile> (default unlisted);
#            -n shows the plan without changing anything
#   auth  log in (get a new refresh token) and exit
#
# Config dir (default ~/.config/videos, override with YT_CONFIG_DIR), kept
# outside the repo:
#   client_secret.json  the OAuth client JSON downloaded from Google Cloud
#   token.json          written by this script: {"refresh_token": "..."}
# If there is no valid refresh token the script logs in automatically: it
# opens a browser, catches the redirect on 127.0.0.1:8085 and saves the token.

set -euo pipefail

dry=no yes=no login=no
while getopts ny opt; do
  case $opt in
    n) dry=yes ;;
    y) yes=yes ;;
    *) echo "usage: yt-update [-n] [-y] <UID> | channel | auth" >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
mode=video
case ${1:-} in
  auth) login=yes ;;
  channel) mode=channel ;;
  privacy) mode=privacy; idfile=${2:?usage: yt-update privacy <idfile> [public|unlisted|private]}; newstatus=${3:-unlisted} ;;
  *) uid=${1:?usage: yt-update [-n] [-y] <UID> | channel | auth} ;;
esac

# shellcheck source=yt-lib.bash
source "$(dirname "${BASH_SOURCE[0]}")/yt-lib.bash"

if [[ $login == yes ]]; then
  command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }
  do_login
  exit 0
fi

root=$(CDPATH= cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# trim: strip leading and trailing blank lines from stdin.
trim() { sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' | sed '/./,$!d'; }

# do_privacy: set privacyStatus for every ID in $idfile (comments allowed).
do_privacy() {
  case $newstatus in public|unlisted|private) ;; *) echo "status must be public, unlisted or private" >&2; exit 2 ;; esac
  [[ -f $idfile ]] || { echo "no such file: $idfile" >&2; exit 1; }
  local ids=() id cur chunk rows body n=0 base=https://www.googleapis.com/youtube/v3/videos
  while IFS= read -r id; do ids+=("$id"); done < <(sed 's/[[:space:]]*#.*//; s/[[:space:]]*$//' "$idfile" | awk 'NF')
  (( ${#ids[@]} > 0 )) || { echo "no IDs in $idfile" >&2; exit 1; }
  ensure_access
  local all='[]' i
  for ((i = 0; i < ${#ids[@]}; i += 50)); do
    chunk=$(IFS=,; echo "${ids[*]:i:50}")
    all=$(jq -c --argjson new "$(curl -fsS -H "Authorization: Bearer $access" "$base?part=snippet,status&id=$chunk")" '. + $new.items' <<<"$all")
  done
  echo "--- setting ${#ids[@]} videos to $newstatus"
  jq -r --arg ns "$newstatus" '.[] | "\(.id)  \(.status.privacyStatus) -> \($ns)  \(.snippet.title[:60])"' <<<"$all"
  local found; found=$(jq length <<<"$all")
  (( found == ${#ids[@]} )) || echo "WARNING: only $found of ${#ids[@]} IDs found on your channel" >&2
  [[ $dry == yes ]] && { echo "(dry run; nothing changed)"; exit 0; }
  if [[ $yes != yes ]]; then
    read -r -p "Change these on YouTube? [y/N] " ans
    [[ $ans == y || $ans == Y ]] || { echo "aborted"; exit 1; }
  fi
  while IFS= read -r row; do
    id=$(jq -r .id <<<"$row"); cur=$(jq -r .status.privacyStatus <<<"$row")
    [[ $cur != "$newstatus" ]] || { echo "$id already $newstatus"; continue; }
    # Send only writable status fields; privacyStatus replaced.
    body=$(jq --arg ns "$newstatus" '{id, status: ({privacyStatus: $ns, embeddable: .status.embeddable, license: .status.license,
      publicStatsViewable: .status.publicStatsViewable, selfDeclaredMadeForKids: .status.selfDeclaredMadeForKids}
      | with_entries(select(.value != null)))}' <<<"$row")
    curl -fsS -X PUT -H "Authorization: Bearer $access" -H 'Content-Type: application/json' \
      -d "$body" "$base?part=status" | jq -r '"\(.id) now \(.status.privacyStatus)"'
    n=$((n + 1))
  done < <(jq -c '.[]' <<<"$all")
  echo "changed $n videos"
}

if [[ $mode == privacy ]]; then do_privacy; exit 0; fi

if [[ $mode == channel ]]; then
  chfile=$root/channel.md
  [[ -f $chfile ]] || { echo "no such file: $chfile" >&2; exit 1; }
  desc=$(trim < "$chfile")
  if [[ $dry == yes ]]; then printf 'CHANNEL DESCRIPTION (%d chars):\n%s\n' "${#desc}" "$desc"; exit 0; fi
  (( ${#desc} <= 1000 )) || { echo "channel description is ${#desc} chars; limit is 1000" >&2; exit 1; }
else
md=${YT_DATA_DIR:-$root/data}/$uid.md
[[ -f $md ]] || { echo "no such file: $md" >&2; exit 1; }

# Title is the first "# " heading.
title=$(sed -n '1s/^# //p' "$md")
[[ -n $title ]] || { echo "no # title on line 1 of $md" >&2; exit 1; }

# Description is everything between the title and the first "## " heading
# (## Category, ## Transcription, ...), with the backticks around the hashtag
# line removed and blank edges trimmed.
desc=$(awk '
  NR == 1 { next }
  /^## / { exit }
  { print }
' "$md" | sed -E 's/^`(#.*)`$/\1/' | trim)

# Category is the first non-blank line under "## Category" (a YouTube category
# name such as "Science & Technology"); empty means leave the category alone.
catname=$(awk '/^## Category/ {f=1; next} /^## / {f=0} f && NF {print; exit}' "$md" \
  | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')

if [[ $dry == yes ]]; then
  printf 'TITLE: %s\n\nDESCRIPTION:\n%s\n' "$title" "$desc"
  [[ -z $catname ]] || printf '\nCATEGORY: %s\n' "$catname"
  exit 0
fi
fi

command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }

ensure_access

api=https://www.googleapis.com/youtube/v3/videos

if [[ $mode == channel ]]; then
  chapi=https://www.googleapis.com/youtube/v3/channels
  # channels.update replaces the whole brandingSettings part, so fetch it and
  # send it all back with only the description changed.
  cur=$(curl -fsS -H "Authorization: Bearer $access" "$chapi?part=brandingSettings&mine=true")
  [[ $(jq '.items | length' <<<"$cur") -eq 1 ]] || { echo "no channel found for this account" >&2; exit 1; }
  chid=$(jq -r '.items[0].id' <<<"$cur")
  body=$(jq --arg d "$desc" '.items[0] | {id, brandingSettings: (.brandingSettings | .channel.description = $d)}' <<<"$cur")
  echo "--- channel $chid"
  echo "--- current description"
  jq -r '.items[0].brandingSettings.channel.description // ""' <<<"$cur"
  echo "--- new description"
  printf '%s\n' "$desc"
  echo "---"
  if [[ $yes != yes ]]; then
    read -r -p "Update channel description on YouTube? [y/N] " ans
    [[ $ans == y || $ans == Y ]] || { echo "aborted"; exit 1; }
  fi
  curl -fsS -X PUT -H "Authorization: Bearer $access" -H 'Content-Type: application/json' \
    -d "$body" "$chapi?part=brandingSettings" | jq '{id, updated: true}'
  exit 0
fi

# Fetch the current snippet. videos.update replaces the whole snippet, so we
# must send back everything (title, categoryId, ...) with only ours changed.
cur=$(curl -fsS -H "Authorization: Bearer $access" "$api?part=snippet&id=$uid")
[[ $(jq '.items | length' <<<"$cur") -eq 1 ]] || { echo "video $uid not found on your channel" >&2; exit 1; }

# Resolve the category name to YouTube's numeric ID (region-specific list).
catid=
if [[ -n $catname ]]; then
  cats=$(curl -fsS -H "Authorization: Bearer $access" \
    "https://www.googleapis.com/youtube/v3/videoCategories?part=snippet&regionCode=${YT_REGION:-US}")
  catid=$(jq -r --arg n "$catname" '[.items[] | select(.snippet.assignable and (.snippet.title | ascii_downcase) == ($n | ascii_downcase)) | .id][0] // empty' <<<"$cats")
  if [[ -z $catid ]]; then
    echo "unknown category \"$catname\"; valid names:" >&2
    jq -r '.items[] | select(.snippet.assignable) | "  " + .snippet.title' <<<"$cats" >&2
    exit 1
  fi
fi

body=$(jq --arg id "$uid" --arg t "$title" --arg d "$desc" --arg c "$catid" '
  .items[0] | {id: $id, snippet: (.snippet | .title = $t | .description = $d
    | (if $c != "" then .categoryId = $c else . end)
    | {title, description, categoryId, tags, defaultLanguage})
    | with_entries(select(.value != null))}' <<<"$cur")

echo "--- current description"
jq -r '.items[0].snippet.description' <<<"$cur"
echo "--- new title:  $title"
if [[ -n $catid ]]; then
  echo "--- category:   $(jq -r '.items[0].snippet.categoryId' <<<"$cur") -> $catid ($catname)"
fi
echo "--- new description"
printf '%s\n' "$desc"
echo "---"

if [[ $yes != yes ]]; then
  read -r -p "Update $uid on YouTube? [y/N] " ans
  [[ $ans == y || $ans == Y ]] || { echo "aborted"; exit 1; }
fi

curl -fsS -X PUT -H "Authorization: Bearer $access" -H 'Content-Type: application/json' \
  -d "$body" "$api?part=snippet" | jq '{id, title: .snippet.title, updated: true}'
